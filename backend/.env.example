PORT=8080
STORAGE_PROVIDER=memory
GCP_PROJECT_ID=your-project-id
# Comma-separated browser origins allowed to call the API (scheme + host + port, no path).
ALLOWED_ORIGIN=http://localhost:5364,http://127.0.0.1:5364
# Required only when STORAGE_PROVIDER=gcp; set exactly the team buckets to scan.
GCP_BUCKET_ALLOWLIST=t024-project-files,t124-project-files,t224-project-files
# Limits object ACL reads per bucket; use 0 only for an intentional full scan.
GCP_MAX_OBJECT_ACLS=100
# GCP mutations stay disabled until you intentionally review/allow them.
GCP_ALLOW_MUTATIONS=false
# Set STORAGE_PROVIDER=gcp to connect to Cloud Storage and Cloud Monitoring.
# Leave this unset when using gcloud ADC impersonation.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# OAuth client ID used by the frontend Google Sign-In button (ID tokens are verified against it)
GOOGLE_CLIENT_ID=
# Comma-separated emails allowed to change IAM / enable UBLA (everyone else is read-only)
ADMIN_EMAILS=admin@example.com

# Local dev only: skip Google token verification and act as DEV_USER_EMAIL with DEV_USER_ROLE
AUTH_DISABLED=false
DEV_USER_EMAIL=dev@localhost
DEV_USER_ROLE=admin
